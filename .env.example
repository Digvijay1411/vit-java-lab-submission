# ---- Copy this file to ".env" and fill in real values ----

# Port the server listens on
PORT=3000

# Full public base URL of the deployed site (no trailing slash).
# Used to build the Google Drive OAuth redirect URI.
# Example: https://java-lab.onrender.com   or   http://localhost:3000
BASE_URL=http://localhost:3000

# ---- Google OAuth Client (Google Cloud Console > APIs & Services > Credentials) ----
# One "Web application" OAuth 2.0 Client ID is used for BOTH:
#   1) Student/Admin "Sign in with Google" (Google Identity Services, client-side)
#   2) The one-time admin "Connect Google Drive" flow (server-side)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ---- Access control ----
# Only emails ending in this domain may log in as a student.
STUDENT_EMAIL_DOMAIN=vitstudent.ac.in

# This exact email is treated as the admin (sets deadlines, views submissions,
# and is whose Google Drive the files get uploaded into).
ADMIN_EMAIL=shinde.digvijay@vit.ac.in

# Name of the Drive folder (in the admin's Drive) submissions are stored in.
DRIVE_FOLDER_NAME=Java

# ---- Secrets ----
# Any long random string, used to sign the login session cookie (JWT).
SESSION_SECRET=change-this-to-a-long-random-string

# Max upload size per file, in MB
MAX_UPLOAD_MB=25
